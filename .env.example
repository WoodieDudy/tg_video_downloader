# Telegram Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional: bot username without @ (auto-detected via getMe() if omitted)
BOT_USERNAME=

# Telegram API credentials from https://my.telegram.org/apps (required for Local Bot API up to 2 GB)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Comma-separated Telegram numeric admin IDs and/or admin usernames (can run /add, /remove, /users, /refresh_cookies)
ADMIN_USER_IDS=123456789
ADMIN_USERNAMES=
ALLOWED_USER_IDS=123456789

# Local Telegram Bot API server URL (inside docker-compose network)
LOCAL_BOT_API_URL=http://telegram-bot-api:8081
LOCAL_BOT_API_IS_LOCAL=true

# Paths inside container
CHROME_PROFILE_DIR=/data/chrome-profile
COOKIES_FILE=/data/cookies/youtube.txt
DOWNLOADS_DIR=/data/downloads

# Chrome cookie refresh interval in minutes (keeps Google/YouTube session alive and cookies fresh)
COOKIE_REFRESH_INTERVAL_MINUTES=240

# Global FIFO queue & timeouts (1 concurrent task by default to avoid parallel YouTube hits)
MAX_CONCURRENT_DOWNLOADS=1
QUEUE_WAIT_TIMEOUT_SECONDS=120
QUEUE_MAX_SIZE=15
QUEUE_TASK_GAP_SECONDS=2.0
FETCH_INFO_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=300
YTDLP_SOCKET_TIMEOUT_SECONDS=20

# Max upload size in MB (Telegram Local Bot API limit is 2000 MB)
MAX_FILE_SIZE_MB=2000

# Group chat limits (prevent heavy/long downloads in group chats)
GROUP_MAX_DURATION_SECONDS=120
GROUP_MAX_FILE_SIZE_MB=150

# Per-user rate limits for non-admins (cache hits are unlimited)
USER_COOLDOWN_SECONDS=20
USER_HOURLY_LIMIT=20

# Optional: VNC password for one-time interactive Chrome login (recommended if port exposed)
VNC_PASSWORD=changeme123

# Optional: JS runtime and PO Token provider URL for yt-dlp
YTDLP_JS_RUNTIME=deno
POT_PROVIDER_URL=http://bgutil-pot-provider:4416
YTDLP_SLEEP_REQUESTS=1.0
YTDLP_CONCURRENT_FRAGMENTS=2

# Telegram video compression settings (used when sending as video, skipped when sending as document)
VIDEO_CRF=24
VIDEO_PRESET=medium

# Admin alerts (sent via Telegram when Google session logs out or free disk space drops below threshold)
LOW_DISK_WARN_GB=3.0
ALERT_COOLDOWN_MINUTES=360
